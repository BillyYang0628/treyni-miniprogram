# ---- Server ----
PORT=3000
DB_PATH=./data/treyni.db
STORAGE_ROOT=./data/uploads
PUBLIC_BASE_URL=http://localhost:3000
AUTH_TOKEN_TTL_MS=604800000

# ---- WeChat ----
# 小程序后台 → 开发管理 → 开发设置
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=
# 订阅消息模板（植物定期养护提醒：thing1 植物名称 / thing2 事项名称 / time3 提醒时间 / thing4 备注）
WECHAT_SUBSCRIBE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_MINIPROGRAM_STATE=developer

# ---- AI provider ----
# deepseek（默认）或 moonshot；换供应商只需改这三行，不用改代码
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_VISION_MODEL=deepseek-flash
# 留空表示按板块策略（用药/换药/视觉/病害介绍/对话/报告 high，方案与压缩 low）
# 调试时可填 disabled/low/high/max
AI_THINKING_OVERRIDE=

# DeepSeek 不可用时的回退供应商（把 AI_PROVIDER 改成 moonshot 即可切换）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6

# ---- 拍照识花（可选，缺失时诊断走纯视觉模型）----
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_PLANT_API_URL=https://aip.baidubce.com/rest/2.0/image-classify/v1/plant

# ---- 天气（浇水模型的输入，可选）----
QWEATHER_API_HOST=
QWEATHER_KEY=
