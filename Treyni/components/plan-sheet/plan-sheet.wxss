.ps-block {
  margin-top: 20rpx;
}

.ps-label {
  display: block;
  margin-bottom: 14rpx;
  color: #1b4d3e;
  font-size: 26rpx;
}

.ps-kinds {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ps-kind {
  width: calc(33.33% - 8rpx);
  padding: 18rpx 6rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 25rpx;
  text-align: center;
}

.ps-kind-on {
  border-color: #1b4d3e;
  background: #1b4d3e;
  color: #ffffff;
  font-weight: 700;
}

.ps-hint {
  display: block;
  margin-top: 12rpx;
  color: #6b7d6b;
  font-size: 22rpx;
  line-height: 1.6;
}

.ps-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-top: 2rpx dashed #d8d2c0;
  border-bottom: 2rpx dashed #d8d2c0;
}

.ps-row-label {
  color: #4a3728;
  font-size: 26rpx;
}

.ps-row-value {
  color: #1b4d3e;
  font-size: 26rpx;
  font-weight: 700;
}

.ps-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
  font-size: 26rpx;
  box-sizing: border-box;
}

.ps-textarea {
  width: 100%;
  height: 130rpx;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
  font-size: 25rpx;
  box-sizing: border-box;
}

.ps-foot {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.ps-btn {
  flex: 1;
  min-height: 84rpx;
  padding: 0;
  font-size: 28rpx;
}
