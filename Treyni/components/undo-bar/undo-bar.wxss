.undo-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 800;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 26rpx;
  border: 3rpx solid #2d3a2d;
  background: #1b4d3e;
  box-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, 0.18);
}

.undo-text {
  color: #ffffff;
  font-size: 26rpx;
}

.undo-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border: 2rpx solid #ffffff;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.undo-count {
  min-width: 36rpx;
  text-align: center;
  color: #f0e2bd;
  font-size: 24rpx;
}
