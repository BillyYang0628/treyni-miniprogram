.ws-body {
  padding: 20rpx 0 8rpx;
}

.ws-textarea {
  width: 100%;
  height: 220rpx;
  padding: 20rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 27rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.ws-image-row {
  margin-top: 20rpx;
}

.ws-image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 140rpx;
  border: 3rpx dashed #2d3a2d;
  background: #ffffff;
}

.ws-image-add-text {
  color: #6b7d6b;
  font-size: 26rpx;
}

.ws-image-box {
  position: relative;
}

.ws-image {
  width: 100%;
  height: 260rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
}

.ws-image-clear {
  display: block;
  margin-top: 8rpx;
  color: #6b7d6b;
  font-size: 22rpx;
  text-align: right;
}

.ws-foot {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.ws-btn {
  flex: 1;
  min-height: 84rpx;
  padding: 0;
  font-size: 28rpx;
}
