page {
  min-height: 100%;
  color: #1a1a1a;
  background: #f0ead6;
  background-image:
    linear-gradient(rgba(27, 77, 62, 0.04) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(27, 77, 62, 0.04) 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx;
  font-family: "Courier New", monospace;
  line-height: 1.5;
  box-sizing: border-box;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.page-title {
  color: #0d3328;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card {
  background: #faf8f0;
  border: 4rpx solid #2d3a2d;
  box-shadow: 8rpx 8rpx 0 rgba(0, 0, 0, 0.12);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 20rpx 32rpx;
  border: 4rpx solid #1a1a1a;
  background: #faf8f0;
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 0;
  box-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, 0.18);
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #1b4d3e;
  color: #ffffff;
  border-color: #0d3328;
}

.btn-outline {
  background: transparent;
  color: #4a3728;
  border-color: #4a3728;
}

.btn-block {
  display: flex;
  width: 100%;
}

.muted {
  color: #6b7d6b;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-title {
  color: #0d3328;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.empty-desc {
  color: #4a3728;
  font-size: 28rpx;
  margin-bottom: 36rpx;
}

.plant-card {
  background: #faf8f0;
  border: 4rpx solid #2d3a2d;
  box-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, 0.12);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.plant-card-img {
  height: 300rpx;
  background: #7ee787;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
}

.plant-card-img image {
  width: 100%;
  height: 100%;
}

.plant-card-body {
  padding: 24rpx;
}

.plant-card-name {
  color: #1a1a1a;
  font-size: 34rpx;
  font-weight: 700;
}

.plant-card-species {
  display: block;
  color: #1b4d3e;
  font-size: 26rpx;
  margin: 8rpx 0 16rpx;
}

.plant-card-meta {
  display: flex;
  gap: 24rpx;
  color: #4a3728;
  font-size: 26rpx;
}

.plant-card-reminder {
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  background: #d4a843;
  border: 2rpx solid #2d3a2d;
  color: #1a1a1a;
  font-size: 24rpx;
}

.form-card {
  background: #faf8f0;
  border: 4rpx solid #2d3a2d;
  box-shadow: 8rpx 8rpx 0 rgba(0, 0, 0, 0.12);
  padding: 32rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: #4a3728;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 28rpx;
}

.form-input {
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 180rpx;
}

.form-placeholder {
  color: #6b7d6b;
}

/* ---- 像素图标尺寸档（配合 <image mode="aspectFit"> 使用） ----
   图标全部是透明底 PNG，按 750rpx 设计稿的整数倍显示，不要用 WXSS 背景图。 */
.icon-xs {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.icon-sm {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
}

.icon-md {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.icon-lg {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
}

.icon-empty {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

/* 图标 + 文字的一行，图标不会被文字挤扁 */
.icon-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.icon-row-text {
  flex: 1;
  min-width: 0;
}

/* 空状态用的像素插画（512 方图，显示 320rpx 足够） */
.empty-illustration {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 24rpx;
}

/* 带前置图标的按钮 */
.btn-with-icon {
  gap: 12rpx;
}

/* 卡片里「图标 + 标题」的一行 */
.card-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
