.guide-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.guide-title {
  color: #0d3328;
  font-size: 34rpx;
  font-weight: 700;
}

.guide-toggle {
  flex: none;
  color: #2d6a4f;
  font-size: 23rpx;
}

.group {
  margin-bottom: 16rpx;
  border: 3rpx solid #2d3a2d;
  background: #faf8f0;
  box-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 0.08);
}

.group-open {
  box-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, 0.12);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}

.group-head-text {
  flex: 1;
  min-width: 0;
}

.group-title {
  display: block;
  color: #0d3328;
  font-size: 29rpx;
  font-weight: 700;
}

.group-hint {
  display: block;
  margin-top: 6rpx;
  color: #6b7d6b;
  font-size: 22rpx;
}

.group-arrow {
  flex: none;
  color: #2d6a4f;
  font-size: 23rpx;
}

.group-body {
  padding: 4rpx 24rpx 24rpx;
  border-top: 2rpx dashed #d8d2c0;
}

.block-h4 {
  display: block;
  margin: 20rpx 0 10rpx;
  color: #1b4d3e;
  font-size: 27rpx;
  font-weight: 700;
}

.block-p {
  display: block;
  margin-bottom: 14rpx;
  color: #1a1a1a;
  font-size: 26rpx;
  line-height: 1.75;
}

.block-quote {
  margin: 16rpx 0;
  padding: 16rpx 18rpx;
  border-left: 8rpx solid #d4a843;
  background: #fffbe8;
}

.block-quote-text {
  color: #4a3728;
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.block-list {
  margin-bottom: 14rpx;
}

.block-li {
  display: flex;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.block-li-dot {
  flex: none;
  color: #2d6a4f;
  font-size: 25rpx;
  line-height: 1.7;
}

.block-li-text {
  flex: 1;
  color: #1a1a1a;
  font-size: 25rpx;
  line-height: 1.7;
}

.block-table {
  margin: 16rpx 0 20rpx;
}

.table-row {
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
}

.table-cell {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.table-head {
  flex: none;
  width: 190rpx;
  color: #6b7d6b;
  font-size: 22rpx;
}

.table-value {
  flex: 1;
  color: #1a1a1a;
  font-size: 24rpx;
  line-height: 1.6;
}
