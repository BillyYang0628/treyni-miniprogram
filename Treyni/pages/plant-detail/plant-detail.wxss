.detail-layout {
  padding-bottom: 40rpx;
}

/* ---- 接下来要做的（聚合卡） ---- */
.agenda-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.agenda-title {
  color: #0d3328;
  font-size: 30rpx;
  font-weight: 700;
}

.agenda-item {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 12rpx 0;
  border-top: 2rpx dashed #d8d2c0;
}

.agenda-when {
  flex: 0 0 130rpx;
  color: #1b4d3e;
  font-size: 23rpx;
  font-weight: 700;
}

.agenda-text {
  flex: 1;
  min-width: 0;
  color: #4a3728;
  font-size: 24rpx;
  line-height: 1.6;
}

.agenda-tag {
  flex: 0 0 auto;
  padding: 2rpx 12rpx;
  border: 2rpx solid #d9a03c;
  color: #8a5a3c;
  font-size: 20rpx;
}

/* 养护历程卡片标题右侧并排两个按钮 */
.section-add-group {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  gap: 10rpx;
}

/* 两个类一起写，是为了盖过下面 .section-add 里的 position:absolute
   （同优先级时后定义的赢，所以必须提高选择器优先级） */
.section-add.section-add-half {
  position: static;
  width: 118rpx;
  min-width: 118rpx;
  max-width: 118rpx;
  font-size: 22rpx;
}

/* 时间线上的"计划"标签 */
.journal-planned {
  padding: 2rpx 10rpx;
  border: 2rpx solid #d9a03c;
  color: #8a5a3c;
  font-size: 20rpx;
}

.plant-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.summary-media {
  flex-shrink: 0;
  width: 220rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #7ee787;
  border: 4rpx solid #2d3a2d;
  font-size: 88rpx;
}

.summary-media image {
  width: 100%;
  height: 100%;
}

.summary-default {
  padding: 20rpx;
}

.meta-item {
  gap: 6rpx;
}

.summary-info {
  flex: 1;
  min-width: 0;
}

.summary-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.detail-name {
  color: #0d3328;
  font-size: 40rpx;
  font-weight: 700;
}

.tag {
  padding: 6rpx 14rpx;
  border: 2rpx solid #2d3a2d;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 22rpx;
}

.tag-green {
  background: #7ee787;
}

.summary-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
  color: #4a3728;
  font-size: 24rpx;
  margin-bottom: 0;
}

.summary-actions {
  display: flex;
  width: 100%;
  flex-basis: 100%;
  box-sizing: border-box;
  gap: 8rpx;
}

.mini-btn {
  flex: 1 1 0;
  min-width: 0;
  max-width: 25%;
  width: auto;
  box-sizing: border-box;
  height: 64rpx;
  padding: 0 4rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 22rpx;
  border-radius: 0;
  box-shadow: 3rpx 3rpx 0 rgba(0, 0, 0, 0.15);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-btn::after {
  border: none;
}

.mini-btn-danger {
  color: #7b2d26;
  border-color: #7b2d26;
}

.mini-btn-ai {
  background: #7b5ea7;
  color: #ffffff;
}

.mini-btn-blue {
  background: #4a7c8c;
}

.section-card {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 560rpx;
  box-sizing: border-box;
  overflow: hidden;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  overflow: hidden;
}

.section-header {
  position: relative;
  min-height: 80rpx;
  padding-right: 200rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  color: #0d3328;
  font-size: 34rpx;
  font-weight: 700;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-add {
  position: absolute;
  top: 0;
  right: 0;
  width: 163rpx;
  min-width: 163rpx;
  max-width: 163rpx;
  height: 66rpx;
  min-height: 66rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 24rpx;
  border-radius: 0;
  text-align: center;
  line-height: 60rpx;
}

.section-add::after {
  border: none;
}

.journal-empty,
.reminder-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 20rpx;
  color: #4a3728;
  text-align: center;
}

/* 养护历程空状态用的是场景插画（512 方图，内容其实是偏宽的 1.36:1），
   放在 560rpx 高的折叠卡里，200rpx 刚好不把标题挤出可视区。 */
.journal-illustration {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 12rpx;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reminder-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
}

.reminder-icon {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
}

.reminder-body {
  flex: 1;
  min-width: 0;
}

.reminder-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reminder-actions .mini-btn {
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  height: 52rpx;
  min-height: 52rpx;
  font-size: 22rpx;
  line-height: 46rpx;
}

.reminder-title {
  display: block;
  color: #0d3328;
  font-size: 28rpx;
  font-weight: 700;
}

.reminder-desc,
.reminder-time {
  display: block;
  color: #4a3728;
  font-size: 24rpx;
}

.reminder-desc {
    white-space: pre-wrap;
}

/* 列表里只显示摘要，超出两行截断，点进详情页看完整内容 */
.reminder-desc {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.reminder-time {
    color: #6b7d6b;
}

/* 逾期后时间文字改用和边框同一档的颜色（具体色值由 WXML 的行内样式给出） */
.reminder-time-overdue {
    font-weight: 700;
}

.reminder-ai {
    display: block;
    color: #1b4d3e;
    font-size: 21rpx;
}

.reminder-ai-row {
    margin-top: 6rpx;
}

.reminder-ai-failed {
    color: #7b2d26;
}

.completed-section {
  background: #faf8f0;
}

.completed-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.completed-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 12rpx 16rpx;
  border: 2rpx dashed #7ee787;
  background: #ffffff;
}

.completed-check {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  margin-top: 2rpx;
}

.completed-body {
  flex: 1;
  min-width: 0;
}

.completed-title {
  display: block;
  color: #0d3328;
  font-size: 26rpx;
  font-weight: 700;
}

.completed-time {
  display: block;
  color: #6b7d6b;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.journal-timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.journal-item {
  position: relative;
  display: flex;
  gap: 16rpx;
  padding-left: 26rpx;
}

.journal-dot {
  position: absolute;
  top: 8rpx;
  left: 0;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #2d3a2d;
  border-radius: 50%;
  background: #7ee787;
}

.journal-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed #7ee787;
}

.journal-type {
  display: block;
  color: #0d3328;
  font-size: 26rpx;
  font-weight: 700;
}

.journal-content,
.journal-time {
  display: block;
  color: #4a3728;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.journal-content {
    white-space: pre-wrap;
}

/* 养护历程列表最多三行，点进详情页看完整内容 */
.journal-content {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
}

.journal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12rpx;
}

.journal-more {
    flex: none;
    color: #6b7d6b;
    font-size: 22rpx;
}

.journal-time {
  color: #6b7d6b;
  font-size: 22rpx;
}

.btn-block {
  margin-top: 20rpx;
}
