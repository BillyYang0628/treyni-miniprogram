.load-error {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.load-error-title {
  color: #7b2d26;
  font-size: 30rpx;
  font-weight: 700;
}

.load-error-msg {
  display: block;
  color: #4a3728;
  font-size: 25rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.load-error-url {
  display: block;
  margin: 16rpx 0 8rpx;
  padding: 12rpx 16rpx;
  background: #f2f8f3;
  color: #1b4d3e;
  font-size: 22rpx;
  word-break: break-all;
}

.load-error-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.load-error-actions .btn {
  flex: 1;
  min-height: 80rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
}

.page-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.plant-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-bottom: 40rpx;
}

.plant-card {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
}

.plant-card-img {
  height: 220rpx;
}

.plant-card-default {
  width: 100%;
  height: 100%;
  padding: 20rpx;
}

.plant-card-body {
  padding: 18rpx;
}

.plant-card-name {
  display: block;
  font-size: 32rpx;
}

.plant-card-species {
  font-size: 24rpx;
}

.plant-card-meta {
  flex-wrap: wrap;
  gap: 12rpx;
}

.plant-card-reminder {
  font-size: 22rpx;
}
