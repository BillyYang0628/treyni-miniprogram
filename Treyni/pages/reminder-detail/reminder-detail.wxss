.head-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 页内提示：替代居中的 wx.showToast，避免遮住下面的卡片文字 */
.inline-notice {
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #e8f3ec;
  border: 1rpx solid #bcd9c8;
  color: #1b4d3e;
  font-size: 24rpx;
  text-align: center;
}

.head-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.head-type {
  color: #0d3328;
  font-size: 30rpx;
  font-weight: 700;
}

.head-status {
  color: #6b7d6b;
  font-size: 22rpx;
}

.head-status-overdue {
  font-weight: 700;
}

.head-title {
  display: block;
  color: #1a1a1a;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.head-plant {
  display: block;
  color: #4a3728;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.head-summary {
  padding: 16rpx 18rpx;
  border-left: 8rpx solid #2d6a4f;
  background: #f2f8f3;
}

.head-summary-text {
  color: #0d3328;
  font-size: 26rpx;
}

.head-rest {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  background: #fff6e5;
  border-left: 8rpx solid #d9a03c;
}

.head-rest-text {
  color: #8a5a12;
  font-size: 23rpx;
  line-height: 1.6;
}

.detail-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.detail-header {
  margin-bottom: 16rpx;
}

.detail-source {
  display: block;
  margin-top: 6rpx;
  color: #6b7d6b;
  font-size: 21rpx;
}

.detail-title {
  color: #0d3328;
  font-size: 30rpx;
  font-weight: 700;
}

.detail-text {
  display: block;
  color: #1a1a1a;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-item {
  display: flex;
  gap: 14rpx;
  padding: 16rpx;
  border-left: 6rpx solid #2d6a4f;
  background: #f7f9f5;
}

.detail-item-icon {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
}

.detail-item-text {
  flex: 1;
  color: #1a1a1a;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.detail-note {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-left: 6rpx solid #d4a843;
  background: #fffbe8;
}

.detail-note-text {
  color: #4a3728;
  font-size: 22rpx;
  line-height: 1.7;
}

.detail-empty {
  padding: 20rpx 0;
}

.generating {
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid #d4a843;
  background: #fffbe8;
}

.generating-title {
  display: block;
  color: #0d3328;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.generating-time {
  display: block;
  color: #4a3728;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.generating-note {
  margin-top: 16rpx;
}

.loading-bar {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  background: #efe6c9;
}

.loading-bar-inner {
  width: 40%;
  height: 100%;
  background: #2d6a4f;
  animation: treyni-loading 1.4s ease-in-out infinite;
}

@keyframes treyni-loading {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(250%);
  }
}

.detail-error {
  padding: 20rpx;
  border: 3rpx solid #7b2d26;
  background: #fff0ef;
}

.error-title {
  display: block;
  color: #7b2d26;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.error-detail {
  display: block;
  color: #7b2d26;
  font-size: 24rpx;
  white-space: pre-wrap;
  margin-bottom: 16rpx;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feedback-card,
.consult-card,
.result-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.ai-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.ai-card-failed {
  border-color: #7b2d26;
  background: #fff0ef;
}

.ai-title {
  display: block;
  color: #0d3328;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.ai-card-failed .ai-title {
  color: #7b2d26;
}

.ai-desc,
.ai-time {
  display: block;
  color: #4a3728;
  font-size: 23rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.ai-error {
  display: block;
  color: #7b2d26;
  font-size: 23rpx;
  margin-bottom: 12rpx;
}

.water-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.water-title {
  display: block;
  color: #0d3328;
  font-size: 28rpx;
  font-weight: 700;
}

/* ---- 土壤水分基准 ---- */
.baseline-card {
  padding: 26rpx;
  margin-bottom: 24rpx;
  border-color: #2d6a4f;
  background: #f2f8f3;
}

.baseline-title {
  color: #0d3328;
  font-size: 28rpx;
  font-weight: 700;
}

.baseline-desc {
  display: block;
  margin-bottom: 18rpx;
  color: #4a3728;
  font-size: 24rpx;
  line-height: 1.7;
}

.baseline-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.baseline-btn {
  flex: 0 0 auto;
  width: calc(50% - 7rpx);
  min-height: 76rpx;
  padding: 0 8rpx;
  background: #ffffff;
  font-size: 26rpx;
}

.water-baseline {
  display: block;
  margin-top: 8rpx;
  color: #4a3728;
  font-size: 22rpx;
  line-height: 1.6;
}

.baseline-adjust {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed #d8d2c0;
}

.baseline-adjust-text {
  color: #6b7d6b;
  font-size: 22rpx;
}

.baseline-chip {
  width: auto;
  min-width: 0;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0 16rpx;
  border: 2rpx solid #2d6a4f;
  border-radius: 0;
  background: #ffffff;
  color: #1b4d3e;
  font-size: 22rpx;
  line-height: 52rpx;
}

.baseline-chip::after {
  border: none;
}

.water-bar {
  width: 100%;
  height: 26rpx;
  overflow: hidden;
  border: 3rpx solid #2d3a2d;
  background: #efe6c9;
}

.water-bar-inner {
  height: 100%;
  background: #4a90a4;
}

.water-percent {
  display: block;
  margin-top: 8rpx;
  color: #1b4d3e;
  font-size: 23rpx;
  font-weight: 700;
}

.water-rows {
  margin-top: 14rpx;
}

.water-row {
  display: block;
  color: #4a3728;
  font-size: 23rpx;
  line-height: 1.7;
}

.water-reset {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-left: 6rpx solid #4a90a4;
  background: #eef5f7;
}

.water-reset-text {
  flex: 1;
  min-width: 0;
  color: #1b4d3e;
  font-size: 23rpx;
  line-height: 1.6;
}

.water-note {
  display: block;
  margin-top: 12rpx;
  color: #8a958a;
  font-size: 20rpx;
  line-height: 1.6;
}

.feedback-title {
  display: block;
  color: #0d3328;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.feedback-sub {
  display: block;
  color: #1b4d3e;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.feedback-desc {
  display: block;
  color: #4a3728;
  font-size: 25rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.feedback-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-title {
  display: block;
  color: #0d3328;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.result-text {
  display: block;
  color: #4a3728;
  font-size: 25rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 20rpx 0;
  padding: 16rpx 18rpx;
  border-left: 8rpx solid #2d6a4f;
  background: #f2f8f3;
}

.result-item {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  padding: 10rpx 0;
}

.result-item + .result-item {
  border-top: 2rpx dashed #b9d3c1;
}

.result-item-label {
  color: #6b7d6b;
  font-size: 21rpx;
}

.result-item-title {
  color: #0d3328;
  font-size: 26rpx;
  font-weight: 700;
}

.result-item-when {
  color: #4a3728;
  font-size: 22rpx;
}

.result-card .btn {
  margin-top: 20rpx;
}

.consult-label {
  display: block;
  margin: 20rpx 0 12rpx;
  color: #0d3328;
  font-size: 26rpx;
  font-weight: 700;
}

.consult-card .detail-text {
  margin-bottom: 24rpx;
}

.btn-danger-outline {
  color: #7b2d26;
  border-color: #7b2d26;
}
