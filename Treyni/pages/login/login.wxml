<view class="page">
  <view class="brand">
    <image class="brand-mark" src="/assets/illustrations/elf-avatar.png" mode="aspectFit" />
    <text class="brand-name">托蕾妮</text>
    <text class="brand-sub">植物养护助手</text>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">账号</text>
      <input
        class="field-input"
        value="{{username}}"
        placeholder="例如 treyni-23x8p"
        placeholder-class="field-ph"
        confirm-type="next"
        bindinput="onUsername"
      />
    </view>

    <view class="field">
      <text class="field-label">口令</text>
      <input
        class="field-input"
        password
        value="{{password}}"
        placeholder="请输入发放给你的口令"
        placeholder-class="field-ph"
        confirm-type="done"
        bindinput="onPassword"
        bindconfirm="onSubmit"
      />
    </view>

    <view wx:if="{{error}}" class="error-text">{{error}}</view>

    <button
      class="submit {{submitting ? 'submit-busy' : ''}}"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >
      登录
    </button>
  </view>

  <text class="footnote">账号由管理员发放，没有自助注册入口。</text>
  <text class="footnote">忘记口令请联系管理员重置。</text>
</view>
