.current-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.current-label {
  display: block;
  color: #6b7d6b;
  font-size: 22rpx;
}

.current-city {
  display: block;
  margin: 8rpx 0;
  color: #0d3328;
  font-size: 38rpx;
  font-weight: 700;
}

.current-note {
  display: block;
  color: #4a3728;
  font-size: 23rpx;
}

.search-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.search-title {
  display: block;
  margin-bottom: 16rpx;
  color: #0d3328;
  font-size: 28rpx;
  font-weight: 700;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  flex: 1;
}

.search-btn {
  flex: none;
  width: 150rpx;
  min-height: 88rpx;
  padding: 0;
  font-size: 27rpx;
}

.search-error {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border: 3rpx solid #7b2d26;
  background: #fff0ef;
  color: #7b2d26;
  font-size: 23rpx;
}

.city-list {
  margin-top: 18rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
}

.city-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  padding: 20rpx 22rpx;
  border-bottom: 2rpx dashed #d8d2c0;
}

.city-item:last-child {
  border-bottom: none;
}

.city-name {
  color: #0d3328;
  font-size: 28rpx;
  font-weight: 700;
}

.city-meta {
  color: #6b7d6b;
  font-size: 22rpx;
}

.search-empty {
  margin-top: 16rpx;
  color: #6b7d6b;
  font-size: 23rpx;
}

.search-hint {
  display: block;
  margin-top: 18rpx;
  color: #8a958a;
  font-size: 21rpx;
}
