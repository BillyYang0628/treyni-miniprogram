.chat-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.chat-head {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.chat-head-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chat-head-avatar {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border: 3rpx solid #2d3a2d;
  background: #faf8f0;
}

.chat-title {
  color: #0d3328;
  font-size: 34rpx;
  font-weight: 700;
}

.chat-sub {
  color: #4a3728;
  font-size: 23rpx;
  margin-top: 6rpx;
}

.chat-body {
  flex: 1;
  min-height: 620rpx;
  max-height: 62vh;
  padding: 8rpx 0;
}

.empty-avatar {
  width: 168rpx;
  height: 168rpx;
  margin-bottom: 24rpx;
}

.change-card {
  margin: 0 0 20rpx;
  padding: 20rpx 22rpx;
  border: 3rpx solid #2d6a4f;
  background: #f2f8f3;
}

.change-title {
  display: block;
  color: #1b4d3e;
  font-size: 23rpx;
  font-weight: 700;
}

.change-text {
  display: block;
  margin: 8rpx 0 16rpx;
  color: #0d3328;
  font-size: 27rpx;
}

.change-actions {
  display: flex;
  gap: 16rpx;
}

.mini-btn {
  flex: 1;
  min-height: 72rpx;
  padding: 12rpx 16rpx;
  border: 3rpx solid #1a1a1a;
  background: #faf8f0;
  color: #1a1a1a;
  font-size: 25rpx;
  border-radius: 0;
}

.mini-btn::after {
  border: none;
}

.mini-btn-primary {
  background: #1b4d3e;
  color: #ffffff;
  border-color: #0d3328;
}

.loading-bar {
  width: 100%;
  height: 10rpx;
  margin-top: 14rpx;
  overflow: hidden;
  background: #efe6c9;
}

.loading-bar-inner {
  width: 40%;
  height: 100%;
  background: #2d6a4f;
  animation: treyni-loading 1.4s ease-in-out infinite;
}

@keyframes treyni-loading {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(250%);
  }
}

.sample-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 12rpx 0 24rpx;
}

.sample {
  align-self: flex-start;
  padding: 12rpx 20rpx;
  border: 3rpx dashed #2d6a4f;
  color: #1b4d3e;
  font-size: 24rpx;
}

/* 输入区：居中放置、左右留一点间隙，文本框固定高度、内部滚动 */
.chat-compose {
  margin: 0 6rpx 16rpx;
}

.chat-textarea {
  width: 100%;
  height: 176rpx;
  padding: 20rpx 22rpx;
  border: 3rpx solid #2d3a2d;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 27rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.chat-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.chat-action {
  flex: 1;
  min-height: 88rpx;
  padding: 0;
  font-size: 28rpx;
}

.chat-bottom-anchor {
  height: 20rpx;
}
/* 气泡样式和「完成提醒」面板共用（改一处两边都生效） */
@import "../../styles/chat-bubble.wxss";
